# Скопируйте файл в .env.local (локально) или добавьте переменные в Vercel → Settings → Environment Variables.
# Все ключи необязательны: если ни одного нет, жители отвечают заготовленными фразами.
# Карту ни к одному сервису НЕ привязывайте — тогда платить нечем, лимиты просто заканчиваются до завтра.

# 1) Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2) Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3) Cloudflare Workers AI — Account ID и API Token с правом Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Сколько сообщений один посетитель может отправить за 10 минут
CHAT_LIMIT_PER_10_MIN=30

# ---------- Редактор энциклопедии (/editor) ----------
# На своём компьютере (npm run dev) редактор работает без этих переменных и пишет прямо в файлы проекта.
# Если задать EDITOR_PASSWORD локально, редактор будет спрашивать пароль и там.
# На опубликованном сайте нужны все три — иначе редактор выключен:
EDITOR_PASSWORD=
# Токен GitHub с доступом только к этому репозиторию: github.com/settings/personal-access-tokens/new →
# Repository access: Only select repositories → lyuprics_world; Permissions → Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=kishalov/lyuprics_world
GITHUB_BRANCH=main
